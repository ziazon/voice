{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth loop case, v1",
  "description": "One test a persona must pass, made from one or more signals.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "persona",
    "created",
    "from_signals",
    "area",
    "situation",
    "expected",
    "match",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "growth-loop/case/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^case-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "created": {
      "$ref": "#/$defs/timestamp"
    },
    "from_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sig-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "situation": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "type": "string",
      "enum": [
        "choice",
        "rubric"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "retired"
      ]
    }
  }
}
