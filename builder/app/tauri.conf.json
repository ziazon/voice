{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Persona Builder",
  "version": "0.1.0",
  "identifier": "dev.personabuilder.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Persona Builder",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'none'",
      "devCsp": "default-src 'self' http://127.0.0.1:5180 ws://127.0.0.1:5180; connect-src ipc: http://ipc.localhost http://127.0.0.1:5180 ws://127.0.0.1:5180; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
