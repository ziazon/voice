(version 1)
(deny default)
(import "system.sb")
; Claude Code checks certificates itself, so close the system certificate service, which can reach the network.
(deny mach-lookup (global-name "com.apple.trustd") (global-name "com.apple.trustd.agent"))

; The child may start only the program, plus the link helper and /bin/bash while signing in.
(allow process-fork)
(allow process-exec (literal (param "PROGRAM")))
(if (string=? (param "SIGN_IN") "yes")
    (allow process-exec
        (literal (string-append (param "RUN_DIR") "/open-sign-in"))
        (literal "/bin/bash")))
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))

; Read only the system code and devices needed to run, the program file, and the profile and run folders.
; The caller gives absolute paths with links resolved for the program and both folders.
(allow file-read*
    (subpath "/usr/bin")
    (subpath "/usr/lib")
    (subpath "/usr/libexec")
    (subpath "/usr/sbin")
    (subpath "/usr/share")
    (subpath "/System")
    (subpath "/private/etc")
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/random")
    (literal "/dev/urandom")
    (literal "/dev/dtracehelper")
    (subpath "/dev/fd")
    (literal (param "PROGRAM"))
    (subpath (param "PROFILE_DIR"))
    (subpath (param "RUN_DIR")))

; Only the profile and this run may change.
(allow file-write*
    (subpath (param "PROFILE_DIR"))
    (subpath (param "RUN_DIR"))
    (literal "/dev/null"))
; The two folders themselves can't be moved, removed, replaced or changed in any way (mode, access list, flags, owner, by any call); their contents remain writable.
(deny file-write* (literal (param "PROFILE_DIR")) (literal (param "RUN_DIR")))

; All outgoing traffic must go through the caller's local proxy.
(allow network-outbound
    (remote tcp (string-append "localhost:" (param "PROXY_PORT"))))

; Signing in needs a local callback listener; ordinary calls do not.
; Known limit: Seatbelt's localhost filter also permits listening on every address
; during sign-in (measured reachable through the Mac's own network address).
; Sign-in is short and started by the person.
(if (string=? (param "SIGN_IN") "yes")
    (allow network-bind network-inbound (local ip "localhost:*")))

; These rules follow the allows so password and key files stay closed even
; inside an allowed folder. Match whole components, in either letter case.
; macOS 27 ignores regex letter case; the letter classes keep these rules right
; if a later macOS starts matching case.
; Keep one rule per built-in name or sequence in core/src/deny.rs.
(deny file-read* file-write*
    (regex #"(^|/)\.[Ss][Ss][Hh](/|$)")
    (regex #"(^|/)\.[Aa][Ww][Ss](/|$)")
    (regex #"(^|/)\.[Gg][Nn][Uu][Pp][Gg](/|$)")
    (regex #"(^|/)\.[Ee][Nn][Vv][^/]*(/|$)")
    (regex #"(^|/)\.[Ee][Nn][Vv][Rr][Cc](/|$)")
    (regex #"(^|/)\.[Nn][Pp][Mm][Rr][Cc](/|$)")
    (regex #"(^|/)\.[Nn][Ee][Tt][Rr][Cc](/|$)")
    (regex #"(^|/)\.[Pp][Gg][Pp][Aa][Ss][Ss](/|$)")
    (regex #"(^|/)[^/]*\.[Pp][Ee][Mm](/|$)")
    (regex #"(^|/)[^/]*\.[Kk][Ee][Yy](/|$)")
    (regex #"(^|/)[^/]*\.[Pp]12(/|$)")
    (regex #"(^|/)[^/]*\.[Kk][Ee][Yy][Cc][Hh][Aa][Ii][Nn](/|$)")
    (regex #"(^|/)[^/]*\.[Kk][Ee][Yy][Cc][Hh][Aa][Ii][Nn]-[Dd][Bb](/|$)")
    (regex #"(^|/)\.[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]\.[Jj][Ss][Oo][Nn](/|$)")
    (regex #"(^|/)\.[Cc][Oo][Nn][Ff][Ii][Gg]/[Gg][Hh](/|$)")
    (regex #"(^|/)\.[Dd][Oo][Cc][Kk][Ee][Rr]/[Cc][Oo][Nn][Ff][Ii][Gg]\.[Jj][Ss][Oo][Nn](/|$)")
    (regex #"(^|/)[Ll][Ii][Bb][Rr][Aa][Rr][Yy]/[Kk][Ee][Yy][Cc][Hh][Aa][Ii][Nn][Ss](/|$)"))

; Keychain access is unavailable here. Let Claude Code keep its own login in
; this one file, while .credentials.json stays denied everywhere else.
(allow file-read* file-write*
    (literal (string-append (param "PROFILE_DIR") "/.credentials.json")))

; The child may use the sign-in helper but cannot change or replace it.
(deny file-write* (literal (string-append (param "RUN_DIR") "/open-sign-in")))
